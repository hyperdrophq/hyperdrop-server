#!/bin/sh
# HyperDrop Server installer for a Linux box with systemd. Generated by
# platforms/linux/build-installer.sh from install.sh.in, the server manifest
# and the provisioner in core/provision/provision.sh, which is embedded below
# verbatim: this file is everything that runs, and it is the same provisioner
# Server Management uploads over SSH.
#
#   curl -fsSL https://gethyperdrop.com/install.sh | sudo sh
#
# Inputs (environment; the terminal is asked for what is missing):
#   HYPERDROP_DDNS_NAME       a free <name>.hyperdrop.link address, OR
#   HYPERDROP_DOMAIN          your own domain (never both)
#   HYPERDROP_ADMIN_USER      the admin username (empty: asked, default admin)
#   HYPERDROP_ADMIN_PASSWORD  the admin password (empty: one is generated)
#   HYPERDROP_IP              this box's public IPv4 (empty: the registry is asked)
#   HYPERDROP_BEHIND_NAT=1    no public IPv4 here; a router forwards 443 to this box
#   HYPERDROP_AUTO_UPDATE=1   a new server installs each release on its own (off otherwise)
#   HYPERDROP_RESET_ADMIN=1   reinstall over an existing server, resetting admin
#   HYPERDROP_ACME_EMAIL, HYPERDROP_ACME_CA   handed to the server as they are
#   HYPERDROP_INSTALL_BASE    where the binaries are (tests); HYPERDROP_ALLOW_PRIVATE=1
#                             waives the address (development only)
#
# Flags: --uninstall [--purge], --help
set -eu

HYPERDROP_VERSION="@VERSION@"
SHA_AMD64="@SHA_AMD64@"
SHA_ARM64="@SHA_ARM64@"
BASE="${HYPERDROP_INSTALL_BASE:-https://gethyperdrop.com/downloads/server}"
REGISTRY="${HYPERDROP_NAMES_URL:-https://api.gethyperdrop.com}"
STAGE_DIR=/tmp/hyperdrop-install
BIN_GZ="$STAGE_DIR/hyperdrop-server.gz"
PROVISIONER="$STAGE_DIR/hyperdrop-provision.sh"
DATA_DIR=/var/lib/hyperdrop

say() { printf '%s\n' "$*"; }
die() { printf 'hyperdrop: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<EOF
HyperDrop Server $HYPERDROP_VERSION installer

  sudo sh install.sh                        install (asks what it needs)
  sudo sh install.sh --uninstall            remove the service and the binary, keep the data
  sudo sh install.sh --uninstall --purge    remove everything, the data included

Environment: HYPERDROP_DDNS_NAME or HYPERDROP_DOMAIN, HYPERDROP_ADMIN_USER,
HYPERDROP_ADMIN_PASSWORD, HYPERDROP_IP, HYPERDROP_BEHIND_NAT=1, HYPERDROP_AUTO_UPDATE=1,
HYPERDROP_RESET_ADMIN=1.
EOF
}

uninstall=0
purge=0
for arg in "$@"; do
    case "$arg" in
        --uninstall) uninstall=1 ;;
        --purge) purge=1 ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; die "unknown argument: $arg" ;;
    esac
done
if [ "$purge" = 1 ] && [ "$uninstall" = 0 ]; then
    die "--purge goes with --uninstall"
fi
[ "$(id -u)" = "0" ] || die "run it with sudo: curl -fsSL https://gethyperdrop.com/install.sh | sudo sh"

# ---------------------------------------------------------------- helpers

# have_tty: whether /dev/tty can be opened. The device node exists on every
# box and its permissions pass; only a process with a controlling terminal
# can open it, which is what a non-interactive ssh session lacks.
have_tty() {
    ( : < /dev/tty ) 2>/dev/null
}

# ask VAR "prompt" "what to set": fills VAR from the terminal when it is
# empty. Under curl | sh stdin is the script itself, so /dev/tty is the only
# place a question can be answered; without one the environment is the only
# way in, and the refusal names the variables to set.
ask() {
    eval "cur=\${$1:-}"
    [ -n "$cur" ] && return 0
    have_tty || die "$3 is not set and there is no terminal to ask on: set it in the environment"
    printf '%s ' "$2" > /dev/tty
    # shellcheck disable=SC2034 # read by the eval below
    IFS= read -r ans < /dev/tty || ans=""
    eval "$1=\$ans"
}

fetch() { # $1 = url, $2 = output file
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --max-time 300 -o "$2" "$1"
    else
        wget -q -T 300 -O "$2" "$1"
    fi
}

fetch_text() { # $1 = url; the body on stdout, empty when it cannot be fetched
    if command -v curl >/dev/null 2>&1; then
        curl -fsS --max-time 20 "$1" 2>/dev/null || true
    else
        wget -q -T 20 -O - "$1" 2>/dev/null || true
    fi
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

# json_true JSON KEY: whether "KEY": true appears, whatever the whitespace.
json_true() {
    printf '%s' "$1" | grep -Eq "\"$2\"[[:space:]]*:[[:space:]]*true"
}

# json_number JSON KEY: the first integer value under KEY, empty when absent.
json_number() {
    printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" | head -1
}

# json_string JSON KEY: the first string value under KEY, empty when absent.
json_string() {
    printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -1
}

is_public_ipv4() {
    printf '%s' "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
    case "$1" in
        0.*|10.*|127.*|169.254.*|192.168.*) return 1 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 1 ;;
        100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 1 ;;
    esac
    return 0
}

# The staging directory follows the provisioning contract: never adopt a
# path someone else owns, never follow a symlink, 0700 once it is ours.
prepare_stage() {
    if [ -L "$STAGE_DIR" ]; then
        die "$STAGE_DIR is a symlink; remove it and try again"
    fi
    # shellcheck disable=SC3067 # test -O is in dash, busybox sh and bash alike
    if [ -e "$STAGE_DIR" ] && { [ ! -d "$STAGE_DIR" ] || [ ! -O "$STAGE_DIR" ]; }; then
        die "$STAGE_DIR exists and is not a directory owned by root; remove it and try again"
    fi
    mkdir -p "$STAGE_DIR"
    chmod 700 "$STAGE_DIR"
    trap 'rm -rf "$STAGE_DIR"' EXIT
}

write_provisioner() {
    umask 077
    cat > "$PROVISIONER" <<'HYPERDROP_PROVISION_SH'
@PROVISIONER@
HYPERDROP_PROVISION_SH
    umask 022
}

# explain turns a provisioner FAIL label into the sentence that says what to
# change; everything else the provisioner printed has already streamed through.
explain() {
    case "$1" in
        no-systemd) say "This box has no systemd; HyperDrop Server runs as a systemd service." ;;
        systemd-readonly) say "The systemd unit directory is read-only here (NixOS, an appliance image), so a unit cannot be added." ;;
        admin-exists) say "This box already runs HyperDrop Server. Update it from the HyperDrop app (Update Server), or re-run with HYPERDROP_RESET_ADMIN=1 to reinstall and reset the admin password; shares are kept." ;;
        binary-corrupt) say "The downloaded server binary did not match its checksum; nothing was installed. Run the installer again." ;;
        health-rollback) say "The new server never became healthy, so the previous binary was put back. journalctl -u hyperdrop says why." ;;
        app-outdated) say "The data on this box was written by a newer HyperDrop Server than this installer carries. Install the newest version." ;;
        schema-check) say "The server could not read its data directory; journalctl -u hyperdrop says why." ;;
        arch-unsupported) say "HyperDrop Server is built for x86_64 and ARM64 only." ;;
    esac
}

# run_provisioner streams the provisioner's output, turning the protocol
# lines into plain ones, and returns its exit status. The status crosses the
# pipe through a marker file because a POSIX pipeline reports only its last
# command.
run_provisioner() {
    rm -f "$STAGE_DIR/exit"
    { sh "$PROVISIONER" 2>&1 && echo "HYPERDROP-EXIT:0" || echo "HYPERDROP-EXIT:$?"; } |
    while IFS= read -r line; do
        case "$line" in
            HYPERDROP-STEP:*) say "==> ${line#HYPERDROP-STEP:*:}" ;;
            HYPERDROP-DONE) ;;
            HYPERDROP-EXIT:*) echo "${line#HYPERDROP-EXIT:}" > "$STAGE_DIR/exit" ;;
            HYPERDROP-FAIL:*)
                label="${line#HYPERDROP-FAIL:}"
                printf 'hyperdrop: failed at %s\n' "$label" >&2
                explain "$label" >&2 ;;
            *) say "    $line" ;;
        esac
    done
    rc=$(cat "$STAGE_DIR/exit" 2>/dev/null || echo 1)
    return "$rc"
}

health() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsS --max-time 2 http://127.0.0.1/api/health 2>/dev/null || true
    else
        wget -qO- -T 2 http://127.0.0.1/api/health 2>/dev/null || true
    fi
}

# --------------------------------------------------------------- uninstall

if [ "$uninstall" = 1 ]; then
    prepare_stage
    write_provisioner
    export HYPERDROP_UNINSTALL=1
    if [ "$purge" = 1 ]; then
        export HYPERDROP_PURGE=1
    fi
    run_provisioner || exit 1
    say "HyperDrop Server is removed."
    if [ "$purge" = 0 ]; then
        say "The data stays in $DATA_DIR; --uninstall --purge removes it too."
    fi
    exit 0
fi

# --------------------------------------------------------------- preflight

say "HyperDrop Server $HYPERDROP_VERSION"
if [ ! -d /run/systemd/system ] || ! command -v systemctl >/dev/null 2>&1; then
    die "this box has no systemd; HyperDrop Server runs as a systemd service"
fi
command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 || die "curl or wget is needed to download the server"
command -v gzip >/dev/null 2>&1 || die "gzip is needed to unpack the server"
command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 || die "sha256sum or shasum is needed to verify the download"

arch=$(uname -m 2>/dev/null || echo unknown)
case "$arch" in
    x86_64|amd64) goarch=amd64; sha="$SHA_AMD64" ;;
    aarch64|arm64) goarch=arm64; sha="$SHA_ARM64" ;;
    *) die "arch-unsupported: HyperDrop Server is built for x86_64 and ARM64; this box is $arch" ;;
esac

# as_svc, the provisioner's own: an operator command runs as the service
# account whenever that account owns the data directory.
@AS_SERVICE@
# An admin is whatever the server's own `admins` subcommand lists; a box with
# no server binary yet has none.
if [ -x /usr/local/bin/hyperdrop-server ] && as_svc env HYPERDROP_DATA="$DATA_DIR" /usr/local/bin/hyperdrop-server admins 2>/dev/null | grep -q . && [ "${HYPERDROP_RESET_ADMIN:-}" != "1" ]; then
    explain admin-exists >&2
    exit 1
fi

# ------------------------------------------------------------- the address

HYPERDROP_DDNS_NAME="${HYPERDROP_DDNS_NAME:-}"
HYPERDROP_DOMAIN="${HYPERDROP_DOMAIN:-}"
HYPERDROP_IP="${HYPERDROP_IP:-}"
address_fqdn=""
if [ -n "$HYPERDROP_DDNS_NAME" ] && [ -n "$HYPERDROP_DOMAIN" ]; then
    die "set HYPERDROP_DDNS_NAME or HYPERDROP_DOMAIN, not both: a free name is the domain"
fi
if [ -z "$HYPERDROP_DDNS_NAME" ] && [ -z "$HYPERDROP_DOMAIN" ] && [ "${HYPERDROP_ALLOW_PRIVATE:-}" != "1" ]; then
    say ""
    say "Your server needs an address: a free HyperDrop address (a name, yours as"
    say "<name>.hyperdrop.link) or a domain you own, such as share.example.com."
    address=""
    ask address "Free name or domain:" "HYPERDROP_DDNS_NAME or HYPERDROP_DOMAIN"
    [ -n "$address" ] || die "an address is required: set HYPERDROP_DDNS_NAME or HYPERDROP_DOMAIN"
    case "$address" in
        *.*) HYPERDROP_DOMAIN="$address" ;;
        *) HYPERDROP_DDNS_NAME="$address" ;;
    esac
fi

if [ -n "$HYPERDROP_DDNS_NAME" ]; then
    printf '%s' "$HYPERDROP_DDNS_NAME" | grep -Eq '^[a-z0-9][a-z0-9-]{3,30}[a-z0-9]$' \
        || die "a free name is 5 to 32 lowercase letters, digits and hyphens: $HYPERDROP_DDNS_NAME"
    answer=$(fetch_text "$REGISTRY/v1/available?name=$HYPERDROP_DDNS_NAME")
    [ -n "$answer" ] || die "the HyperDrop registry at $REGISTRY did not answer; check this box's internet access"
    if ! json_true "$answer" available; then
        die "the name $HYPERDROP_DDNS_NAME is not available: $(json_string "$answer" reason)"
    fi
    if ! json_true "$answer" ok; then
        # A shared limit holds the first publication back; it refuses nothing.
        # The server keeps the approval and publishes the name on its own.
        wait_reason=$(json_string "$answer" reason)
        wait_until=$(json_number "$answer" retryAfter)
        wait_when=""
        if [ -n "$wait_until" ]; then
            wait_when=$(date -u -d "@$wait_until" '+%b %e, %H:%M UTC' 2>/dev/null || true)
        fi
        case "$wait_reason" in
            certificates) say "Note: free addresses share a weekly HTTPS certificate quota and this week's is used up${wait_when:+ until about $wait_when}. The server keeps retrying and publishes $HYPERDROP_DDNS_NAME.hyperdrop.link on its own." ;;
            pool) say "Note: the free-address pool is full right now. The server keeps retrying and publishes $HYPERDROP_DDNS_NAME.hyperdrop.link on its own once room is made." ;;
            blocked) die "the registry does not accept free names from this internet connection; use your own domain" ;;
            *) say "Note: the registry cannot publish $HYPERDROP_DDNS_NAME.hyperdrop.link right now ($wait_reason). The server keeps retrying on its own." ;;
        esac
    fi
    address_fqdn="$HYPERDROP_DDNS_NAME.hyperdrop.link"
fi

if [ -n "$HYPERDROP_DOMAIN" ]; then
    printf '%s' "$HYPERDROP_DOMAIN" | grep -Eq '^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$' \
        || die "$HYPERDROP_DOMAIN does not look like a domain name (lowercase, like share.example.com)"
    address_fqdn="$HYPERDROP_DOMAIN"
fi

if [ "${HYPERDROP_BEHIND_NAT:-}" = "1" ]; then
    [ -z "$HYPERDROP_IP" ] || die "behind NAT, leave HYPERDROP_IP unset: the router's address is not this box's"
elif [ -n "$address_fqdn" ]; then
    if [ -z "$HYPERDROP_IP" ]; then
        seen=$(fetch_text "$REGISTRY/v1/ip")
        HYPERDROP_IP=$(json_string "$seen" ip)
    fi
    is_public_ipv4 "$HYPERDROP_IP" || die "this box needs a public IPv4 (the registry saw \"$HYPERDROP_IP\"): set HYPERDROP_IP to it, or HYPERDROP_BEHIND_NAT=1 behind a router that forwards 443 here"
fi

# ------------------------------------------------------------ the account

# The first administrator's username. Asked on a terminal, defaulting to
# "admin"; the server enforces the same rule, so a bad name is refused here
# before anything is downloaded.
HYPERDROP_ADMIN_USER="${HYPERDROP_ADMIN_USER:-}"
if [ -z "$HYPERDROP_ADMIN_USER" ] && [ "${HYPERDROP_RESET_ADMIN:-}" != "1" ] && have_tty; then
    printf '%s ' "Admin username [admin]:" > /dev/tty
    IFS= read -r HYPERDROP_ADMIN_USER < /dev/tty || HYPERDROP_ADMIN_USER=""
fi
if [ -n "$HYPERDROP_ADMIN_USER" ]; then
    case "$HYPERDROP_ADMIN_USER" in
        *[!a-z0-9._-]*) die "HYPERDROP_ADMIN_USER \"$HYPERDROP_ADMIN_USER\": a username is 3-32 characters of a-z, 0-9, dot, dash or underscore" ;;
    esac
    n=${#HYPERDROP_ADMIN_USER}
    if [ "$n" -lt 3 ] || [ "$n" -gt 32 ]; then
        die "HYPERDROP_ADMIN_USER \"$HYPERDROP_ADMIN_USER\": a username is 3-32 characters of a-z, 0-9, dot, dash or underscore"
    fi
fi
shown_user="${HYPERDROP_ADMIN_USER:-admin}"

# ------------------------------------------------------------ the password

HYPERDROP_ADMIN_PASSWORD="${HYPERDROP_ADMIN_PASSWORD:-}"
generated=0
if [ -z "$HYPERDROP_ADMIN_PASSWORD" ]; then
    if have_tty; then
        printf '%s ' "Admin password (leave empty to generate one):" > /dev/tty
        stty -echo < /dev/tty 2>/dev/null || true
        IFS= read -r HYPERDROP_ADMIN_PASSWORD < /dev/tty || HYPERDROP_ADMIN_PASSWORD=""
        stty echo < /dev/tty 2>/dev/null || true
        printf '\n' > /dev/tty
    fi
    if [ -z "$HYPERDROP_ADMIN_PASSWORD" ]; then
        HYPERDROP_ADMIN_PASSWORD=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 20)
        generated=1
    fi
fi

# ------------------------------------------------------------ the download

prepare_stage
say "==> downloading hyperdrop-server-$HYPERDROP_VERSION-linux-$goarch.gz"
rm -f "$BIN_GZ"
fetch "$BASE/hyperdrop-server-$HYPERDROP_VERSION-linux-$goarch.gz" "$BIN_GZ" \
    || die "the download failed: $BASE/hyperdrop-server-$HYPERDROP_VERSION-linux-$goarch.gz"
chmod 600 "$BIN_GZ"
actual=$(sha256_of "$BIN_GZ")
if [ "$actual" != "$sha" ]; then
    rm -f "$BIN_GZ"
    die "binary-corrupt: the download's SHA-256 is $actual, this installer expects $sha; nothing was installed, run it again"
fi
write_provisioner

# ------------------------------------------------------------- the install

export HYPERDROP_ADMIN_PASSWORD HYPERDROP_DOMAIN HYPERDROP_DDNS_NAME HYPERDROP_IP
HYPERDROP_BIN_SHA256="$sha"
export HYPERDROP_BIN_SHA256
for passthrough in HYPERDROP_ADMIN_USER HYPERDROP_BEHIND_NAT HYPERDROP_AUTO_UPDATE HYPERDROP_RESET_ADMIN HYPERDROP_ALLOW_PRIVATE HYPERDROP_ACME_EMAIL HYPERDROP_ACME_CA; do
    eval "val=\${$passthrough:-}"
    if [ -n "$val" ]; then
        # shellcheck disable=SC2163 # exports the variable passthrough names
        export "$passthrough"
    fi
done
run_provisioner || exit 1

# ------------------------------------------------------------- the summary

if [ -n "$HYPERDROP_IP" ]; then
    served="https://$HYPERDROP_IP"
elif [ "${HYPERDROP_ALLOW_PRIVATE:-}" = "1" ]; then
    served="http://<this box's address>"
else
    served="https://<this box's address>"
fi
address="$served"
say ""
if [ -n "$HYPERDROP_DDNS_NAME" ]; then
    say "==> claiming $address_fqdn"
    i=0
    claimed=0
    while [ "$i" -lt 60 ]; do
        if health | grep -q "\"domain\":\"$address_fqdn\""; then
            claimed=1
            break
        fi
        i=$((i + 1))
        sleep 1
    done
    if [ "$claimed" = 1 ]; then
        address="https://$address_fqdn"
        say "Your address is $address. The certificate is issued within a minute or two."
    else
        say "$address_fqdn is not published yet. If the registry is holding it back for a shared limit, the server keeps retrying on its own; your account page (https://gethyperdrop.com/account/) says why and when. If it was taken since the check, choose another name."
        say "The server answers on $served meanwhile; the Domain card in the HyperDrop app can choose another name."
    fi
elif [ -n "$HYPERDROP_DOMAIN" ]; then
    address="https://$HYPERDROP_DOMAIN"
    say "Point these DNS records at this server; the certificate is issued once they resolve:"
    say "    A    $HYPERDROP_DOMAIN    $HYPERDROP_IP"
    say "    A    files.$HYPERDROP_DOMAIN    $HYPERDROP_IP"
    if [ "${HYPERDROP_BEHIND_NAT:-}" = "1" ]; then
        say "    (behind NAT: both records carry your router's public address, with 443 forwarded here)"
    fi
    say "Until they resolve the server answers on $served."
fi
say ""
say "HyperDrop Server $HYPERDROP_VERSION is running."
say "    Address:   $address"
if [ "${HYPERDROP_RESET_ADMIN:-}" = "1" ] && [ -z "$HYPERDROP_ADMIN_USER" ]; then
    say "    User:      your admin account"
else
    say "    User:      $shown_user"
fi
if [ "$generated" = 1 ]; then
    say "    Password:  $HYPERDROP_ADMIN_PASSWORD"
else
    say "    Password:  the one you set"
fi
say ""
auto_update_status=$(as_svc env HYPERDROP_DATA="$DATA_DIR" /usr/local/bin/hyperdrop-server auto-update 2>/dev/null || true)
if [ "$auto_update_status" = "on" ]; then
    say "Automatic updates are on: the server installs each new release on its own."
else
    say "Automatic updates are off. An administrator can turn them on in the HyperDrop app or in Server Management: https://gethyperdrop.com/docs/updates/#server"
fi
say ""
say "Open HyperDrop on your Mac, choose Join a HyperDrop server, and enter these."
