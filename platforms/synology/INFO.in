package="hyperdrop"
version="@VERSION@-1"
displayname="HyperDrop"
description="Self-hosted file sharing for the HyperDrop apps. Serves HTTPS itself on the ports you choose: on your router, forward port 443 to the HTTPS port, and port 80 to the HTTP port when you use a Free address."
maintainer="HyperDrop"
arch="@ARCH@"
os_min_ver="@OSMIN@"
thirdparty="yes"
silent_upgrade="yes"
checksum="@CHECKSUM@"
changelog="@CHANGELOG@"
